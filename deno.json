    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check mod.ts cli.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1"
  },
  "compilerOptions": {
    "strict": true
  }
}
